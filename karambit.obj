# Krunker Low-Poly Karambit 3D Model
# Gerado para uso em mods e Resource Swappers
o Karambit_LowPoly

# --- VÉRTICES (Coordenadas 3D no espaço X Y Z) ---
# Aro / Anel Traseiro
v -3.5000 0.8000 0.1500
v -4.2000 0.0000 0.1500
v -3.5000 -0.8000 0.1500
v -2.8000 0.0000 0.1500
v -3.5000 0.8000 -0.1500
v -4.2000 0.0000 -0.1500
v -3.5000 -0.8000 -0.1500
v -2.8000 0.0000 -0.1500

# Meio do Cabo
v -1.5000 0.5000 0.2000
v -1.5000 -0.5000 0.2000
v -1.5000 0.5000 -0.2000
v -1.5000 -0.5000 -0.2000

# Base da Lãmina e Guarda
v 0.0000 0.3000 0.1500
v 0.0000 -0.7000 0.1500
v 0.0000 0.3000 -0.1500
v 0.0000 -0.7000 -0.1500

# Curva da Lãmina (Meio)
v 1.2000 -0.2000 0.0500
v 0.8000 -1.5000 0.0500
v 1.2000 -0.2000 -0.0500
v 0.8000 -1.5000 -0.0500

# Ponta da Garra (Vértice Único Afiado)
v 1.8000 -2.5000 0.0000

# --- FACES (Conexão dos polígonos) ---
# Anel Traseiro (Lado Direito)
f 1 2 3 4
# Anel Traseiro (Lado Esquerdo)
f 8 7 6 5
# Conexões do Anel (Bordas)
f 1 5 6 2
f 2 6 7 3
f 3 7 8 4
f 4 8 5 1

# Cabo (Transição do Anel para a Lâmina)
f 4 3 10 9
f 11 12 7 8
f 1 4 9 11
f 3 2 12 10
f 9 10 12 11

# Base da Lâmina
f 9 13 14 10
f 12 16 15 11
f 9 11 15 13
f 10 14 16 12

# Curva da Lâmina (Corpo Principal)
f 13 17 18 14
f 16 20 19 15
f 13 15 19 17
f 14 18 20 16

# Ponta da Karambit (Triângulos afiados)
f 17 21 18
f 20 21 19
f 17 19 21
f 18 21 20
